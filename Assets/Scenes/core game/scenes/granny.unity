      value: 
      objectReference: {fileID: 1797906727}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: badLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'badLines.Array.data[0]'
      value: "Nana: This doesn\u2019t taste quite right\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'badLines.Array.data[1]'
      value: "But it\u2019s alright! Practice a bit more and you\u2019ll be ready
        for the picnic!  "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'badLines.Array.data[2]'
      value: See ya!
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: greetingLines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: thankYouLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[0]'
      value: Wow. Click tab to continue.
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[1]'
      value: Welcome to Whisker! This is a baking game where you can drop the different
        ingredients in bins to get a food!
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[2]'
      value: The customers have their order recipe on their heads!
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[3]'
      value: Move with WASD keys  or arrow keys and pick things up with E key!
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[4]'
      value: Now the story begins!
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[5]'
      value: "Nana(customer): HEY! you\u2019re Coco right? "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[6]'
      value: 'Coco(you): Yes??? But, who are you? '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[7]'
      value: 'Nana: Haha sorry, I forgot to introduce myself! '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[8]'
      value: "Nana: I\u2019m Nana. "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[9]'
      value: "Nana: You\u2019re new to the neighbourhood right? I love the way you\u2019ve
        set this bakery up! Let me be your first customer!!! "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'thankYouLines.Array.data[0]'
      value: "Nana: You sure have some great baking skills! I can\u2019t wait to
        see what you bring to the picnic! "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'thankYouLines.Array.data[1]'
      value: 'Coco: Huh? What picnic? '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'thankYouLines.Array.data[2]'
      value: 'Nana: Oops. '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'thankYouLines.Array.data[3]'
      value: 'Nana: I forgot to tell you! In a few days, we have a community picnic
        and everyone brings homemade goods. Don''t worry, I''ll remind you again
        when the day comes! '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[10]'
      value: "Nana: Hmmm\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[11]'
      value: 'Nana: I''m feeling a baguette today, can you make that for me? '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[12]'
      value: "Coco: \u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[13]'
      value: 'Nana: What are you waiting for? Head to the kitchen! '
      objectReference: {fileID: 0}
    - target: {fileID: 6466090054451681488, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: 'greetingLines.Array.data[14]'
      value: "Nana: By the way, whenever  you\u2019re unsure about how to make the
        pastry, just check the order combination on top of my head."
      objectReference: {fileID: 0}
    - target: {fileID: 8329693109501353853, guid: fe344659c58fc4553aaa2edc1f4cbbbf, type: 3}
      propertyPath: m_Controller
      value: 
      objectReference: {fileID: 9100000, guid: 95d54db25c0e34f2892d14b432c3237a, type: 2}
    m_RemovedComponents:
