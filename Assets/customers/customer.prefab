MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9157975155196360858}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29cc2ec7bf33d47779aac64189d715cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sPoint: {fileID: 0}
  ePoint: {fileID: 0}
  timer: 1000
  happyP: {fileID: 0}
  sadP: {fileID: 0}
  anim: {fileID: 4565954161359661896}
  greetingLines:
  - " HEY! you\u2019re Coco right? "
  - 'Yes??? But, who are you? '
  - " Haha sorry, I forgot to introduce myself! I\u2019m Nana. "
  - " You\u2019re new to the neighbourhood right? I love the way you\u2019ve set
    this bakery up! Let me be your first customer!!! "
  - " You\u2019re new to the neighbourhood right? I love the way you\u2019ve set
    this bakery up! Let me be your first customer!!! "
  - " Hmmm\u2026 I'm feeling a baguette today, can you make that for me? "
  - "\u2026 "
  - 'What are you waiting for? Head to the kitchen! '
  - "By the way, whenever  you\u2019re unsure about how to make the pastry, just
    check the order receipt on my head!"
  thankYouLines:
  - "You sure have some great baking skills! I can\u2019t wait to see what you bring
    to the picnic! "
  - 'Huh? What picnic? '
  - ' Oops. I forgot to tell you! In a few days, we have a community picnic and everyone
    brings homemade goods. Don''t worry, I''ll remind you again when the day comes!  '
  badLines:
  - "This doesn\u2019t taste quite right\u2026"
  - "But it\u2019s alright! Practice a bit more and you\u2019ll be ready for the
    picnic! "
